# Copy to backend/.env and adjust. Never commit real secrets.

ENVIRONMENT=development
DEBUG=true

# Database — SQLite for local dev; switch to PostgreSQL for production.
DATABASE_URL=sqlite:///./backend.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/student_data

# Auth — MUST change in production (any long random string)
JWT_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_TTL_MINUTES=480
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Photo storage (private object storage abstraction; local FS adapter)
STORAGE_ROOT=./storage
MAX_UPLOAD_BYTES=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
PHOTO_MIN=6
PHOTO_MAX=8

# The PWA origin(s) — comma separated
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
